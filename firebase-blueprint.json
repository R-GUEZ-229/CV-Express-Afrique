{
  "entities": {
    "CV": {
      "title": "CV",
      "description": "A generated CV document for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "userData": { "type": "object" },
        "cv": { "type": "string" },
        "letter": { "type": "string" },
        "paid": { "type": "boolean" },
        "status": { "type": "string" },
        "template": { "type": "string" },
        "unlockCode": { "type": "string" },
        "unlockTimestamp": { "type": "number" },
        "transactionRef": { "type": "string" },
        "paymentPhone": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "date", "userData", "cv", "letter", "paid", "status", "template", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/cvs/{cvId}": {
      "schema": { "$ref": "#/entities/CV" },
      "description": "User generated CVs"
    }
  }
}
